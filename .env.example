# ── Database ────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root_password
DB_NAME=ml_chege_photos

# ── Qdrant (vector store) ──────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=face_embeddings

# ── Model settings ─────────────────────────────────────────────
# Insightface model pack name.
# IMPORTANT: The buffalo_l model weights shipped with insightface are
# licensed for non-commercial research only (see README.md).  Swap this
# to a commercially-licensed pack if you need production use.
FACE_MODEL_PACK=buffalo_l
FACE_DET_THRESH=0.5

# ── Sensitive attributes ───────────────────────────────────────
# If "true", the pipeline also estimates ethnicity/race per face.
# WARNING: This is biometric "special category" data under GDPR Art. 9
# and is regulated by several US state laws (IL BIPA, TX CUBI, WA ESHB
# 1907).  End‑user consent must be obtained at the product level before
# enabling this flag.
INCLUDE_SENSITIVE_ATTRIBUTES=false

# ── Clustering ─────────────────────────────────────────────────
HDBSCAN_MIN_CLUSTER_SIZE=2
HDBSCAN_MIN_SAMPLES=1
CLUSTER_METRIC=cosine

# ── Scan timeouts ──────────────────────────────────────────────
# Seconds after which a stuck "processing" image is reset to "unscanned"
SCAN_STALE_TIMEOUT_SEC=300

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=9051
LOG_LEVEL=info
